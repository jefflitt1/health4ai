---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page not found — health4.ai"
  description="This page does not exist on health4.ai."
>
  <nav class="flex items-center justify-between px-6 py-5 max-w-3xl mx-auto">
    <a href="/" class="text-green-400 font-bold text-lg tracking-tight hover:opacity-80 transition-opacity">health4.ai</a>
  </nav>

  <main class="px-6 py-24 max-w-3xl mx-auto text-center">
    <div class="text-green-500 text-xs font-mono mb-4 tracking-widest uppercase">404</div>
    <h1 class="text-3xl font-bold text-white mb-4">Page not found</h1>
    <p class="text-neutral-400 text-sm leading-relaxed max-w-md mx-auto mb-8">
      There is no page at this address on health4.ai. It may have moved, or the link may
      be out of date. Try the homepage, or one of the pages below.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 text-sm">
      <a href="/" class="text-green-400 hover:underline">Home</a>
      <a href="/how-it-works/" class="text-green-400 hover:underline">How it works</a>
      <a href="/mcp-tools/" class="text-green-400 hover:underline">MCP tools</a>
      <a href="/blog/" class="text-green-400 hover:underline">Blog</a>
      <a href="/sitemap-index.xml" class="text-green-400 hover:underline">Sitemap</a>
      <a href="/llms.txt" class="text-green-400 hover:underline">llms.txt</a>
    </div>
  </main>

  <footer class="border-t border-neutral-800/60 px-6 py-8 mt-12">
    <div class="max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-neutral-600 text-xs">
      <span>© 2026 health4.ai · Not a medical device</span>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="/about/" class="hover:text-neutral-400 transition-colors">About</a>
        <a href="/contact/" class="hover:text-neutral-400 transition-colors">Contact</a>
        <a href="/privacy/" class="hover:text-neutral-400 transition-colors">Privacy</a>
        <a href="/terms/" class="hover:text-neutral-400 transition-colors">Terms</a>
      </div>
    </div>
  </footer>
</Layout>
