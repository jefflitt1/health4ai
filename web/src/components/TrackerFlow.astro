---
// Homepage + /how-it-works animated flow diagram: many trackers -> Apple Health
// -> health4ai -> your own database -> AI clients. Apple Watch is one source
// among many, not the headline. Approved brief: Jeff 2026-09-25.
// Text chips only -- no third-party logos (EXISTING_ASSETS constraint).

interface TrackerGroup {
  label: string;
  items: string[];
}

const groups: TrackerGroup[] = [
  { label: 'Rings & watches', items: ['Apple Watch', 'Oura', 'Garmin', 'Polar', 'Coros', 'Ultrahuman'] },
  { label: 'Scales & blood pressure', items: ['Withings', 'Renpho', 'Omron'] },
  { label: 'Glucose', items: ['Dexcom'] },
  { label: 'Workouts', items: ['Strava', 'Peloton', 'Nike Run Club'] },
  { label: 'Nutrition', items: ['MyFitnessPal', 'Cronometer'] },
  { label: 'Sleep', items: ['Eight Sleep', 'AutoSleep'] },
];

const aiClients = ['Claude', 'ChatGPT', 'Cursor', 'Ollama'];
---

<section id="tracker-flow" class="tf" aria-labelledby="tf-heading">
  <h2 id="tf-heading" class="tf-heading">Every tracker that shares with Apple Health</h2>
  <p class="tf-subline">Not just Apple Watch. If it writes to Apple Health, health4ai syncs it.</p>

  <!-- Visual diagram: presentation only, described for screen readers by the list below -->
  <div class="tf-diagram" aria-hidden="true">
    <div class="tf-sources">
      {groups.map((group) => (
        <div class="tf-group">
          <span class="tf-group-label">{group.label}</span>
          <div class="tf-chips">
            {group.items.map((item) => (
              <span class="tf-chip">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <svg class="tf-connector" viewBox="0 0 24 44" width="24" height="44">
      <line x1="12" y1="2" x2="12" y2="32" class="tf-flow-line" />
      <polygon points="12,42 5,29 19,29" class="tf-arrowhead" />
    </svg>

    <div class="tf-node tf-node-health">Apple Health</div>

    <svg class="tf-connector" viewBox="0 0 24 44" width="24" height="44">
      <line x1="12" y1="2" x2="12" y2="32" class="tf-flow-line" />
      <polygon points="12,42 5,29 19,29" class="tf-arrowhead" />
    </svg>

    <div class="tf-node tf-node-brand">
      health4ai
      <small>reads Apple Health, syncs continuously</small>
    </div>

    <svg class="tf-connector" viewBox="0 0 24 44" width="24" height="44">
      <line x1="12" y1="2" x2="12" y2="32" class="tf-flow-line" />
      <polygon points="12,42 5,29 19,29" class="tf-arrowhead" />
    </svg>

    <div class="tf-node tf-node-db">
      Your database
      <small>Supabase or Postgres that you own</small>
    </div>

    <svg class="tf-connector" viewBox="0 0 24 44" width="24" height="44">
      <line x1="12" y1="2" x2="12" y2="32" class="tf-flow-line" />
      <polygon points="12,42 5,29 19,29" class="tf-arrowhead" />
    </svg>

    <div class="tf-clients">
      {aiClients.map((client) => (
        <span class="tf-chip tf-chip-ai">{client}</span>
      ))}
    </div>
  </div>

  <!-- Accessible description of the same flow, for assistive tech -->
  <ul class="sr-only">
    <li>Rings and watches: Apple Watch, Oura, Garmin, Polar, Coros, Ultrahuman.</li>
    <li>Scales and blood pressure: Withings, Renpho, Omron.</li>
    <li>Glucose: Dexcom.</li>
    <li>Workouts: Strava, Peloton, Nike Run Club.</li>
    <li>Nutrition: MyFitnessPal, Cronometer.</li>
    <li>Sleep: Eight Sleep, AutoSleep.</li>
    <li>All of the above sync to Apple Health.</li>
    <li>Apple Health syncs to health4ai.</li>
    <li>health4ai syncs to a database you own: Supabase or Postgres.</li>
    <li>Your database is queried by AI clients: Claude, ChatGPT, Cursor, Ollama.</li>
  </ul>

  <p class="tf-proof">One real database: 40 devices and apps. The biggest source isn't Apple Watch. It's Oura.</p>
  <p class="tf-footnote">
    Coverage depends on what each brand shares with Apple Health. Some hold back metrics (for
    example, WHOOP does not share Recovery or Strain), and Fitbit and FreeStyle Libre do not
    share to Apple Health at all.
  </p>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .tf {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 3.5rem;
    text-align: center;
  }

  .tf-heading {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #fff;
    margin: 0 0 0.5rem;
  }

  .tf-subline {
    font-size: 0.9375rem;
    color: var(--muted);
    margin: 0 0 2.25rem;
  }

  .tf-diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tf-sources {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
    max-width: 640px;
  }

  .tf-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    min-width: 9.5rem;
  }

  .tf-group-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .tf-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.375rem;
  }

  .tf-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #e2c8d4;
    background: rgba(255, 45, 120, 0.08);
    border: 1px solid rgba(255, 45, 120, 0.18);
    white-space: nowrap;
  }

  .tf-connector {
    display: block;
    margin: 0.15rem 0;
    flex-shrink: 0;
  }

  .tf-flow-line {
    stroke: var(--accent-light);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: tf-flow 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .tf-arrowhead {
    fill: var(--accent-light);
  }

  @keyframes tf-flow {
    0%   { stroke-dashoffset: 60; opacity: 0.35; }
    55%  { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0.35; }
  }

  .tf-node {
    padding: 0.75rem 1.25rem;
    border-radius: 0.85rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .tf-node small {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .tf-node-brand {
    border-color: var(--accent);
  }

  .tf-clients {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 420px;
  }

  .tf-chip-ai {
    color: #fff;
    background: rgba(255, 45, 120, 0.14);
    border-color: rgba(255, 45, 120, 0.32);
    font-size: 0.8125rem;
    padding: 0.4rem 0.85rem;
  }

  .tf-proof {
    margin: 2.25rem 0 0.75rem;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    max-width: 34rem;
    margin-left: auto;
    margin-right: auto;
  }

  .tf-footnote {
    font-size: 0.75rem;
    color: var(--muted);
    max-width: 34rem;
    margin: 0 auto;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .tf-flow-line {
      animation: none;
      stroke-dashoffset: 0;
      opacity: 0.7;
    }
  }
</style>
