---
// Asks before any optional third-party script runs. Rendered only when at least one vendor is
// configured for the build (PUBLIC_* env in Cloudflare Pages); the vendors' IDs travel as data
// attributes and src/lib/consent.mjs loads them only after the visitor accepts.
const posthogKey  = import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN as string | undefined;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST as string | undefined;
const clarityId   = import.meta.env.PUBLIC_CLARITY_PROJECT_ID as string | undefined;

const vendors = [
  posthogKey && posthogHost && 'PostHog (product analytics)',
  clarityId && 'Microsoft Clarity (session recordings and heatmaps)',
].filter(Boolean) as string[];
const list = vendors.length < 2
  ? vendors.join('')
  : `${vendors.slice(0, -1).join(', ')} and ${vendors[vendors.length - 1]}`;
---
{vendors.length > 0 && (
  <div
    id="h4a-consent"
    hidden
    data-posthog-key={posthogKey && posthogHost ? posthogKey : undefined}
    data-posthog-host={posthogKey && posthogHost ? posthogHost : undefined}
    data-clarity-id={clarityId || undefined}
  >
    <section class="consent-banner" data-consent-banner role="region" aria-label="Cookie choice" hidden>
      <p>
        health4.ai would like to use {list}. They set cookies or browser storage and record how you
        use this site. Nothing from them loads unless you accept. <a href="/privacy/">Privacy policy</a>
      </p>
      <div class="consent-actions">
        <button type="button" data-consent="decline">Decline</button>
        <button type="button" data-consent="accept">Accept</button>
      </div>
    </section>
    <p class="consent-change"><button type="button" data-consent="change" hidden>Cookie choices</button></p>
  </div>
)}

<script>
  import { startConsent } from '../lib/consent.mjs';
  const root = document.getElementById('h4a-consent');
  if (root) startConsent({ root, win: window, doc: document, storage: window.localStorage });
</script>

<style>
  .consent-banner {
    position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50;
    max-width: 720px; margin: 0 auto; padding: 16px;
    display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    color: #e5e7eb; font-size: 14px; line-height: 1.5;
  }
  .consent-banner[hidden], .consent-change button[hidden] { display: none; }
  .consent-banner p { margin: 0; flex: 1 1 320px; }
  .consent-banner a { color: var(--accent-light); text-decoration: underline; }
  .consent-actions { display: flex; gap: 8px; }
  .consent-actions button {
    min-width: 96px; padding: 8px 16px; border-radius: 8px; font: inherit; cursor: pointer;
    border: 1px solid var(--border); background: transparent; color: #fff;
  }
  .consent-change { margin: 0; padding: 12px 16px 24px; text-align: center; }
  .consent-change button {
    background: none; border: 0; padding: 0; color: var(--muted); font: inherit; font-size: 12px;
    text-decoration: underline; cursor: pointer;
  }
</style>
