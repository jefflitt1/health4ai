<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit usage descriptions (required for App Store and Health access) -->
	<key>NSHealthShareUsageDescription</key>
	<string>health4ai reads only the Health data types you select to sync them to the backend you configure for analysis and archival.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>health4ai saves indoor cycling rides to Apple Health only if you turn on "Bike on your network" and import rides from your own bike: the workout, calories, distance, power, cadence and heart rate. It writes nothing otherwise.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>health4ai connects to the bike address you enter on your Wi-Fi to read your rides and save them to Apple Health.</string>

	<!-- Background modes. 'fetch' backs the BGAppRefreshTask sync safety net, 'processing' the
	     charger-only BGProcessingTask history backfill. Removed 2026-06 for an iOS 27 Beta 1
	     XPC crash; restored 2026-09-14 on the public iOS 27 (D335). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- BGTaskScheduler permitted identifiers. Must match SyncEngine.backgroundSyncTaskIdentifier
	     and BulkExportManager.backfillTaskIdentifier exactly, or BGTaskScheduler.submit throws. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.health4ai.sync</string>
		<string>com.health4ai.backfill</string>
	</array>

	<!-- UIApplicationSceneManifest is required on iOS 27 even for apps built with older SDKs;
	     without it iOS 27 uses a legacy XPC launch path that crashes in _xpc_init_service.
	     SwiftUI App protocol handles scene delegation automatically; empty UISceneConfigurations is correct. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>

	<!-- Standard app metadata -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>health4ai</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Require iOS 17 -->
	<key>MinimumOSVersion</key>
	<string>17.0</string>

	<!-- UI -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Declares no non-exempt encryption — suppresses the App Store Connect compliance prompt on every upload -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- App Transport Security: HTTPS only (Supabase is always HTTPS), except plain HTTP to local-network
	     hosts (.local names and IP literals) for "Bike on your network". The URL is also validated in
	     code (BikeURLValidator) to private/link-local/.local hosts only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
